--- a/src/train/train.py
+++ b/src/train/train.py
@@ -207,6 +207,26 @@
     if get_model_vocab_size(model.config) < len(processor.tokenizer):
         model.resize_token_embeddings(len(processor.tokenizer))
 
+    # [F-CoVT] LoRA wrap. Upstream has a lora_enable flag but never applies LoRA.
+    # Slim version: LoRA on language-model linears + only the 3 new latent-token rows trainable
+    # (not full embed_tokens/lm_head copies, which made checkpoints ~20 GB).
+    if training_args.lora_enable:
+        from peft import LoraConfig, get_peft_model
+        lora_kwargs = dict(
+            r=training_args.lora_rank,
+            lora_alpha=training_args.lora_alpha,
+            lora_dropout=training_args.lora_dropout,
+            target_modules=r".*language_model.*\.(q_proj|k_proj|v_proj|o_proj|gate_proj|up_proj|down_proj)$",
+            modules_to_save=["projection_head"] if getattr(model, "projection_head", None) is not None else None,
+        )
+        try:
+            lora_cfg = LoraConfig(trainable_token_indices=[latent_id, latent_start_id, latent_end_id], **lora_kwargs)
+        except TypeError:  # older peft without trainable_token_indices: new tokens stay frozen
+            lora_cfg = LoraConfig(**lora_kwargs)
+        # no task_type: PeftModelForCausalLM passes return_dict twice into Future-L1's patched forward
+        model = get_peft_model(model, lora_cfg)
+        model.print_trainable_parameters()
+
     # configure latent loss type
     model.config.latent_loss = training_args.latent_loss
     model.config.latent_lambda = training_args.latent_lambda
